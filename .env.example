# Server-only. Enables real routes (Routes API), geocoding and Places search.
# Restrict this key by API + server IP. Without it the app falls back to straight-line estimates.
GOOGLE_MAPS_API_KEY=

# Comma-separated emails that get the ADMIN role on register/login.
ADMIN_EMAILS=

# Production database (Turso / libSQL). Without these, a local SQLite file is used
# (./data/thakurdekha.db locally, ephemeral /tmp on Vercel).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Image uploads (Vercel Blob). Without it, images go to ./uploads (ephemeral on Vercel).
BLOB_READ_WRITE_TOKEN=

# Optional overrides
# DATABASE_PATH=./data/thakurdekha.db
# UPLOAD_DIR=./uploads
# SEED_DATABASE=true

# Gemini pandal-hopping assistant (server-only). Get a key at https://aistudio.google.com/apikey
# Without it, /assistant shows "not switched on".
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
